# 서버 환경변수(ADR-0011). 로컬에서는 셸이나 IDE 실행 설정에 넣는다. 값을 커밋하지 않는다.
PORT=8080
# Supabase Project Settings → Database → Connection string(JDBC). 비밀번호는 DATABASE_PASSWORD로 따로.
DATABASE_URL=jdbc:postgresql://<host>:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=
# JWKS 주소는 이 값에 /auth/v1/.well-known/jwks.json 을 붙여 만든다.
SUPABASE_URL=https://<project-id>.supabase.co
WEB_ORIGIN=http://localhost:5173
# AI 도구 연결(ADR-BCK-015). 이 서버의 바깥 주소. 연결 주소는 <PUBLIC_URL>/mcp
PUBLIC_URL=http://localhost:8080
# 승인 화면 로그인. web/.env.local의 VITE_SUPABASE_PUBLISHABLE_KEY와 같은 값(공개 키).
# Supabase Auth → URL Configuration → Redirect URLs에 <PUBLIC_URL>/oauth/callback을 더한다.
SUPABASE_PUBLISHABLE_KEY=
# 요약·태그·글자 읽기용 LLM(ADR-BCK-014, COM-002). Google AI Studio에서 만든 키. 무료 등급은 입력을 학습에 쓸 수 있으니 팀 자료만 넣는다(COM-002 규칙 3).
GEMINI_API_KEY=
GEMINI_MODEL=
# 파일 원본(ADR-BCK-002 결정 2). Supabase Storage → Settings → S3 Connection. 버킷 items는 비공개로 만든다.
STORAGE_S3_ENDPOINT=https://<project-id>.supabase.co/storage/v1/s3
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=items
