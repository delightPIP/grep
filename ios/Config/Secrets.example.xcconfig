// 이 파일을 같은 폴더에 Secrets.xcconfig로 복사해 값을 채운다. Secrets.xcconfig는 커밋하지 않는다.
// 값은 web/.env.local의 VITE_SUPABASE_URL·VITE_SUPABASE_PUBLISHABLE_KEY와 같다(브라우저에 노출해도 되는 공개 키).
// xcconfig는 `//` 뒤를 주석으로 읽으므로 URL은 `https:/$()/` 꼴로 쓴다.

SUPABASE_URL = https:/$()/<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY =
